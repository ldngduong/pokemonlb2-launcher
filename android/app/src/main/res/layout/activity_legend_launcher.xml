<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <!-- Full-bleed Wallpaper matching Windows Launcher -->
    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Wallpaper"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper" />

    <!-- Bottom Dark Gradient Scrim for Crisp Text Contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_gradient" />

    <!-- Top Dark Glass Header Bar + Divider + Soft Shadow -->
    <LinearLayout
        android:id="@+id/topHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topGlassBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_glass"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/fz_univers_bold"
                android:letterSpacing="0.06"
                android:text="POKÉMON LEGEND BLACK 2"
                android:textColor="#B494A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvChipHeaderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_badge"
                android:fontFamily="@font/fz_univers_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="60HZ • AUTO"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1EFFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:background="@drawable/bg_header_shadow" />
    </LinearLayout>

    <!-- Bottom Foreground Section (Responsive Portrait Phone Layout) -->
    <LinearLayout
        android:id="@+id/bottomForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fz_univers_bold"
            android:maxLines="1"
            android:text="POKEMON LEGEND BLACK 2"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeTextType="uniform" />

        <!-- Primary Action Pill: VÀO GAME -->
        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_white"
            android:fontFamily="@font/fz_univers_bold"
            android:stateListAnimator="@null"
            android:text="VÀO GAME"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="14sp" />

        <!-- Secondary Action Pills: UPDATE & CÀI ĐẶT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_dark"
                android:fontFamily="@font/fz_univers_bold"
                android:stateListAnimator="@null"
                android:text="UPDATE"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_dark"
                android:fontFamily="@font/fz_univers_bold"
                android:stateListAnimator="@null"
                android:text="CÀI ĐẶT"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Neutral Status Line matching Windows Launcher -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/fz_univers"
            android:lineSpacingExtra="2dp"
            android:text="Đang kiểm tra trạng thái..."
            android:textColor="@color/text_slate"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- In-App Dark Glass Modals -->
    <include layout="@layout/overlay_modals" />

</FrameLayout>
